{
  "name": "qvac-model-compare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k 'vite --host 127.0.0.1' 'wait-on http://127.0.0.1:5173 && electron .'",
    "build": "tsc --noEmit && vite build",
    "test": "node --test electron/*.test.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@qvac/sdk": "0.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.qvac.modelcompare",
    "productName": "QVAC Model Compare",
    "asar": true,
    "asarUnpack": ["node_modules/**"],
    "files": ["dist/**", "electron/**", "package.json", "node_modules/**"],
    "mac": { "target": "dir", "identity": null, "category": "public.app-category.productivity" }
  }
}
